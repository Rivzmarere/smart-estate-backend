# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.co.zw
CORS_ALLOWED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
CSRF_TRUSTED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
# postgres://USER:PASSWORD@HOST:5432/DBNAME  (leave empty to use local SQLite in development)
DATABASE_URL=postgres://smartestate:smartestate@db:5432/smartestate
POSTGRES_DB=smartestate
POSTGRES_USER=smartestate
POSTGRES_PASSWORD=smartestate

# WhatsApp Cloud API (Meta app dashboard > WhatsApp > API setup)
WHATSAPP_ENABLED=False
WHATSAPP_DRY_RUN=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Name of the approved template: "{{1}} arrived at the gate at {{2}} (code {{3}})"
WHATSAPP_TEMPLATE_VISITOR_ARRIVED=
# "Smart Estate receipt {{1}}: {{2}} received for {{3}}. Balance now {{4}}."
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=
# "{{1}} is at the gate to visit you. Let them in?" with quick-reply buttons Approve / Decline
WHATSAPP_TEMPLATE_WALK_IN=
# "Your repair {{1}} ({{2}}) is now: {{3}}."
WHATSAPP_TEMPLATE_REPAIR_UPDATE=
# "Message from your estate office: {{1}}" (lets the office reply after 24 hours)
WHATSAPP_TEMPLATE_OFFICE_MESSAGE=
# Name and portal address for the estate created on first install
DEFAULT_ESTATE_NAME=My Estate
DEFAULT_ESTATE_SLUG=main

# SMS: console (send nothing) or twilio
SMS_BACKEND=console
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public addresses (Paynow sends payment results to PUBLIC_API_URL/paynow/result/...)
PUBLIC_API_URL=https://api.example.co.zw
RESIDENT_PORTAL_URL=https://residents.example.co.zw
MEDIA_ROOT=/data/media

# Paynow (paynow.co.zw > Receive payments > Integrations). One integration per currency.
PAYNOW_DRY_RUN=False
PAYNOW_USD_INTEGRATION_ID=
PAYNOW_USD_INTEGRATION_KEY=
PAYNOW_ZWG_INTEGRATION_ID=
PAYNOW_ZWG_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
