# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.co.zw
CORS_ALLOWED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
CSRF_TRUSTED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
# postgres://USER:PASSWORD@HOST:5432/DBNAME  (leave empty to use local SQLite in development)
DATABASE_URL=postgres://smartestate:smartestate@db:5432/smartestate
POSTGRES_DB=smartestate
POSTGRES_USER=smartestate
POSTGRES_PASSWORD=smartestate
