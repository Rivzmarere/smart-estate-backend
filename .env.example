# Copy to .env and fill in. Never commit .env.  See DEPLOY.md.

# ---- Addresses (three DNS names pointing at the server) ----------------
API_DOMAIN=api.example.co.zw
ADMIN_DOMAIN=admin.example.co.zw
PORTAL_DOMAIN=residents.example.co.zw
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=
# Optional: estate the resident portal serves when its link has no ?estate=
PORTAL_ESTATE=

# ---- Django ------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.co.zw
CORS_ALLOWED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
CSRF_TRUSTED_ORIGINS=https://admin.example.co.zw,https://residents.example.co.zw
# Paynow sends payment results to PUBLIC_API_URL/paynow/result/...
PUBLIC_API_URL=https://api.example.co.zw
RESIDENT_PORTAL_URL=https://residents.example.co.zw
MEDIA_ROOT=/data/media
# Name and portal address of the estate created on first install
DEFAULT_ESTATE_NAME=My Estate
DEFAULT_ESTATE_SLUG=main

# ---- Database ----------------------------------------------------------
# Use a long random password; it must match DATABASE_URL.
POSTGRES_DB=smartestate
POSTGRES_USER=smartestate
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://smartestate:change-me@db:5432/smartestate
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2

# ---- WhatsApp Cloud API (Meta app dashboard > WhatsApp > API setup) -----
WHATSAPP_ENABLED=False
WHATSAPP_DRY_RUN=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# The bot's number in international format, e.g. 263771234567 ("Chat on WhatsApp" in the portal)
WHATSAPP_PUBLIC_NUMBER=
# Approved template names (wording in README.md)
WHATSAPP_TEMPLATE_VISITOR_ARRIVED=
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=
WHATSAPP_TEMPLATE_WALK_IN=
WHATSAPP_TEMPLATE_REPAIR_UPDATE=
WHATSAPP_TEMPLATE_OFFICE_MESSAGE=

# ---- SMS: console (send nothing) or twilio -----------------------------
SMS_BACKEND=console
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- USSD (*xxx#) ---------------------------------------------------------
# Give the USSD gateway this callback: https://API_DOMAIN/ussd/<USSD_SECRET>
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))". Empty = USSD off.
USSD_SECRET=

# ---- Paynow (paynow.co.zw > Receive payments > Integrations) -----------
# Server-wide default; each estate can set its own in Estate settings.
PAYNOW_DRY_RUN=False
PAYNOW_USD_INTEGRATION_ID=
PAYNOW_USD_INTEGRATION_KEY=
PAYNOW_ZWG_INTEGRATION_ID=
PAYNOW_ZWG_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
